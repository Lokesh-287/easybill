{
  "doctype": "DocType",
  "name": "Device",
  "module": "Easybill",
  "issingle": 0,
  "custom": 0,
  "fields": [
    {
      "fieldname": "device_code",
      "fieldtype": "Data",
      "label": "Device Code",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "device_type",
      "fieldtype": "Select",
      "label": "Device Type",
      "options": "web\nandroid\nwindows",
      "default": "web"
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "options": "User",
      "label": "User"
    },
    {
      "fieldname": "series_prefix",
      "fieldtype": "Data",
      "label": "Series Prefix"
    },
    {
      "fieldname": "last_seen",
      "fieldtype": "Datetime",
      "label": "Last Seen",
      "in_list_view": 1
    },
    {
      "fieldname": "app_version",
      "fieldtype": "Data",
      "label": "App Version"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "active\nrevoked",
      "default": "active",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "autoname": "field:device_code"
}